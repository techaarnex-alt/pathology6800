# Copy this file to .env. The actual .env is ignored by Git.
AUTH_USERNAME=Admin
# Generate a password hash with: node -e "const c=require('crypto'),p=process.env.PASSWORD,s=c.randomBytes(16);console.log('scrypt:'+s.toString('base64')+':'+c.scryptSync(p,s,64).toString('base64'))"
AUTH_PASSWORD_HASH=scrypt:replace-with-base64-salt:replace-with-base64-hash
PORT=3000
